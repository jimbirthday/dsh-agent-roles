{
  "name": "@deepseek-ai/dsh-experimental-agent-role-profile",
  "description": "Named agent roles and the role_agent delegation tool in one experimental bundle",
  "version": "0.2.1-rc.2",
  "icon": "./icon.svg",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jimbirthday/dsh-agent-roles.git",
    "directory": "packages/agent-role-profile"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-experimental-client-ui-agent-role-config": "workspace:*",
    "@deepseek-ai/dsh-experimental-agent-role": "workspace:*",
    "@deepseek-ai/dsh-experimental-tool-agent-role": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-agent-loop": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-agent-loop-testkit": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-app-boot": "^0.2.1-rc.2",
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/cordis-plugin-include": "^1.0.10",
    "@deepseek-ai/dsh-experimental-agent-role": "workspace:*",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-subagent": "^0.2.1-rc.2",
    "js-yaml": "^4.3.2"
  },
  "homepage": "https://github.com/jimbirthday/dsh-agent-roles#readme"
}
